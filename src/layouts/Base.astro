---
import '../styles/global.css';
import { nav, site } from '../lib/data';
const { title, description = 'Premium men\'s supplements without the premium markup. Denver, Colorado.', image = '/images/site/hero-f43694.png', type = 'website' } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title ? `${title} | Guys Goals` : 'Guys Goals | Premium Men\'s Supplements, No Bullshit Pricing'}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<link rel="icon" href={site.footer.logo} type="image/svg+xml">
<meta property="og:type" content={type}><meta property="og:site_name" content="Guys Goals"><meta property="og:title" content={title || 'Guys Goals'}><meta property="og:description" content={description}><meta property="og:image" content={new URL(image, Astro.site)}><meta property="og:url" content={canonical}>
<meta name="twitter:card" content="summary_large_image">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Assistant:wght@400;600;700&family=Merriweather+Sans:wght@700;800&display=swap" rel="stylesheet">
</head>
<body>
<div class="archive-bar">Guys Goals closed in 2025. This is an archived version of the store; nothing here is for sale. A <a href="https://tchristiaan.com" target="_blank" rel="noopener">TChristiaan</a> project by Thomas Bouwman.</div>
<header class="header"><div class="container">
  <a class="brand" href="/"><img src={site.footer.logo} alt="" width="48" height="48"><span>Guys Goals</span></a>
  <nav class="nav" aria-label="Main">{nav.map(n => <a href={n.href} aria-current={path === n.href || (n.href !== '/' && path.startsWith(n.href)) ? 'page' : undefined}>{n.label}</a>)}</nav>
</div></header>
<main><slot /></main>
<footer class="footer"><div class="container">
  <div class="cols">
    <div><h4>Main Menu</h4>{nav.map(n => <a href={n.href}>{n.label}</a>)}</div>
    <div><h4>Quick Links</h4><a href="/collections/all">All Supplements</a><a href="/blogs/mens-health">Comparisons</a><a href="/pages/about-us">About</a><a href="/pages/contact">Contact</a></div>
    <div><h4>Policies</h4><a href="/pages/data-sharing-opt-out">Your Privacy Choices</a></div>
    <div><img src={site.footer.logo} alt="Guys Goals" width="56" height="56" style="margin-bottom:12px"><p style="font-size:14px;color:var(--muted)">{site.footer.newsletter}</p></div>
  </div>
  <div class="bottom"><span>© 2025 Guys Goals. Archived 2026.</span><span>A <a href="https://tchristiaan.com" style="display:inline;color:var(--green);font-weight:600">TChristiaan</a> project by Thomas Bouwman</span></div>
</div></footer>
<script>
  const els=[...document.querySelectorAll('.reveal')];
  if(!matchMedia('(prefers-reduced-motion: reduce)').matches){const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{rootMargin:'0px 0px -8% 0px'});els.forEach(e=>e.getBoundingClientRect().top<innerHeight?e.classList.add('in'):io.observe(e))}else els.forEach(e=>e.classList.add('in'));
</script>
</body>
</html>
