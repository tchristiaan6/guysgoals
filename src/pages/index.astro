---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import PostCard from '../components/PostCard.astro';
import { site, posts, productByHandle } from '../lib/data';
const c = site.comparison;
---
<Base description={`${site.hero.title}. ${site.hero.text}`}>
<section class="hero" style={`background-image:url(${site.hero.image})`}><div class="container hero__inner">
  <h1>{site.hero.title}</h1>
  <p class="hero__sub">{site.hero.text}</p>
  <a class="btn btn--light" href="/collections/all">Shop all supplements</a>
</div></section>

{site.lists.map((l: any, i: number) => <>
  <section class="section reveal"><div class="container">
    <h2 style="font-size:26px;margin-bottom:20px">{l.title}</h2>
    <div class="grid grid--4">{l.products.map((h: string) => productByHandle(h)).filter(Boolean).map((p: any) => <ProductCard p={p} />)}</div>
  </div></section>
  {i === 0 && <section class="section section--soft reveal"><div class="container cmp">
    <h2 style="text-align:center">{c.title}</h2>
    <p style="text-align:center;max-width:640px;margin:0 auto 28px;color:var(--muted)">{c.intro}</p>
    <div class="table-wrap"><table>
      <thead><tr>{c.head.map((h: string) => <th>{h}</th>)}</tr></thead>
      <tbody>{c.rows.map((r: string[]) => <tr>{r.map((cell: string, j: number) => <td class:list={{ 'td--num': j > 0, 'td--green': j === 4 }}>{cell}</td>)}</tr>)}</tbody>
    </table></div>
    <p class="cmp__note">{c.note}</p>
  </div></section>}
</>)}

{site.banners.map((b: any) => <section class="banner reveal" style={`background-image:url(${b.image})`}><div class="container banner__inner">
  <h2>{b.title}</h2>
  <p>{b.text}</p>
  <div class="chips">{b.chips.map((ch: any) => <a class="chip" href={ch.href}>{ch.label}</a>)}</div>
</div></section>)}

<section class="cta"><div class="container cta__inner">
  <h2>{site.cta.heading}</h2>
  <p class="cta__text">{site.cta.text}</p>
  <p class="cta__sub">{site.cta.sub}</p>
  <a class="btn btn--sand" href="/collections/all">{site.cta.cta}</a>
</div></section>

<section class="section reveal"><div class="container">
  <div class="row-head"><h2 style="font-size:26px;margin:0">{site.blog_heading}</h2><a href="/blogs/mens-health">All comparisons</a></div>
  <div class="grid grid--3">{posts.slice(0, 3).map((p: any) => <PostCard post={p} />)}</div>
</div></section>
</Base>
<style>
.hero{position:relative;background:#333 center/cover no-repeat;color:#fff;min-height:520px;display:flex;align-items:center}
.hero::before{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.35),rgba(0,0,0,.55))}
.hero__inner{position:relative;width:100%;padding-top:72px;padding-bottom:72px}.hero h1{color:#fff;font-size:clamp(40px,6.5vw,76px);font-weight:800;margin-bottom:12px;text-shadow:0 2px 20px rgba(0,0,0,.35)}
.hero__sub{font-size:20px;font-style:italic;color:#eef;margin-bottom:28px}
.table-wrap{overflow-x:auto;border:1px solid var(--border);border-radius:var(--radius);background:#fff}
table{border-collapse:collapse;width:100%;font-size:15px;min-width:640px}th{background:var(--navy);color:var(--navy-text);text-align:left;padding:12px 14px;font-family:var(--font-head);font-size:13px;letter-spacing:.04em}
td{padding:11px 14px;border-top:1px solid var(--border)}.td--num{text-align:right;white-space:nowrap;font-variant-numeric:tabular-nums}.td--green{color:var(--green);font-weight:700}
.cmp__note{font-size:12px;color:var(--muted);margin:12px 0 0;text-align:center}
.banner{position:relative;background:#222 center/cover no-repeat;color:#fff;min-height:420px;display:flex;align-items:center}
.banner::before{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.62) 0%,rgba(0,0,0,.25) 60%,rgba(0,0,0,0) 100%)}
.banner__inner{position:relative;width:100%;padding-top:56px;padding-bottom:56px}.banner h2{color:#fff;font-size:clamp(34px,5vw,58px);font-weight:800;margin-bottom:8px}.banner p{font-size:18px;color:#e9eaf0;max-width:520px}
.chips{display:flex;flex-wrap:wrap;gap:10px}.chip{background:#fff;color:var(--ink);text-decoration:none;font-weight:600;font-size:14px;padding:9px 16px;border-radius:999px;transition:all .2s}.chip:hover{background:var(--green);color:#fff}
.cta{background:var(--navy-2);color:#fff;padding:80px 0}.cta__inner{text-align:center;max-width:820px}.cta h2{color:#fff;font-size:clamp(28px,3.6vw,42px)}.cta__text{font-size:22px;line-height:1.45;color:#eef;margin-bottom:22px}.cta__sub{font-size:15px;color:#cfd2df;margin-bottom:28px}
.row-head{display:flex;justify-content:space-between;align-items:baseline;gap:16px;margin-bottom:22px}.row-head a{font-size:14px;font-weight:600}
</style>
